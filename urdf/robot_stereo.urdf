<?xml version="1.0"?>
<robot name="diff_rover">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.5 0.3 0.1"/></geometry>
      <material name="Silver"><color rgba="0.75 0.75 0.75 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.5 0.3 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.0833" ixy="0" ixz="0"
               iyy="0.2167" iyz="0"
               izz="0.2833"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
      <material name="Black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003542" ixy="0" ixz="0"
               iyy="0.003542" iyz="0"
               izz="0.005"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.125 0.175 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
      <material name="Black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003542" ixy="0" ixz="0"
               iyy="0.003542" iyz="0"
               izz="0.005"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.125 -0.175 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="DarkGrey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0"
               izz="0.0003"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.2 0 -0.05" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder length="0.04" radius="0.05"/></geometry>
      <material name="Blue"><color rgba="0.1 0.1 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.04" radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <link name="stereo_housing_link">
    <visual>
      <geometry><box size="0.02 0.14 0.04"/></geometry>
      <material name="DarkBlue"><color rgba="0.1 0.1 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.14 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0003"/>
    </inertial>
  </link>

  <joint name="stereo_housing_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stereo_housing_link"/>
    <origin xyz="0.26 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="cam_left_link">
    <visual>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="LensGrey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000004" ixy="0" ixz="0"
               iyy="0.000004" iyz="0"
               izz="0.000004"/>
    </inertial>
  </link>

  <joint name="cam_left_joint" type="fixed">
    <parent link="stereo_housing_link"/>
    <child link="cam_left_link"/>
    <origin xyz="0.01 0.035 0" rpy="0 0 0"/>
  </joint>

  <link name="cam_left_optical_link"/>
  <joint name="cam_left_optical_joint" type="fixed">
    <parent link="cam_left_link"/>
    <child link="cam_left_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="cam_right_link">
    <visual>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="LensGrey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000004" ixy="0" ixz="0"
               iyy="0.000004" iyz="0"
               izz="0.000004"/>
    </inertial>
  </link>

  <joint name="cam_right_joint" type="fixed">
    <parent link="stereo_housing_link"/>
    <child link="cam_right_link"/>
    <origin xyz="0.01 -0.035 0" rpy="0 0 0"/>
  </joint>

  <link name="cam_right_optical_link"/>
  <joint name="cam_right_optical_joint" type="fixed">
    <parent link="cam_right_link"/>
    <child link="cam_right_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="stereo_depth_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="stereo_depth_joint" type="fixed">
    <parent link="stereo_housing_link"/>
    <child link="stereo_depth_link"/>
    <origin xyz="0.01 0 0" rpy="0 0 0"/>
  </joint>

  <link name="stereo_depth_optical_link"/>
  <joint name="stereo_depth_optical_joint" type="fixed">
    <parent link="stereo_depth_link"/>
    <child link="stereo_depth_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher"/>

    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="cam_left_link">
    <sensor name="cam_left" type="camera">
      <pose relative_to="cam_left_link">0 0 0 0 0 0</pose>
      <topic>stereo/left/image_raw</topic>
      <camera_info_topic>stereo/left/camera_info</camera_info_topic>
      <ignition_frame_id>cam_left_optical_link</ignition_frame_id>  <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera name="cam_left">
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="cam_right_link">
    <sensor name="cam_right" type="camera">
      <pose relative_to="cam_right_link">0 0 0 0 0 0</pose>
      <topic>stereo/right/image_raw</topic>
      <camera_info_topic>stereo/right/camera_info</camera_info_topic>
      <ignition_frame_id>cam_right_optical_link</ignition_frame_id> <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera name="cam_right">
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="stereo_depth_link">
    <sensor name="stereo_depth" type="depth_camera">
      <pose relative_to="stereo_depth_link">0 0 0 0 0 0</pose>
      <topic>stereo/depth/image_raw</topic>
      <camera_info_topic>stereo/depth/camera_info</camera_info_topic>
      <ignition_frame_id>stereo_depth_optical_link</ignition_frame_id> <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera name="stereo_depth">
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>